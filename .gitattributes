# Normalise line endings so the repo is identical on Windows, macOS and Linux.
* text=auto eol=lf

*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sql text eol=lf

*.png binary
*.jpg binary
*.ico binary
*.ttf binary
*.woff binary
*.woff2 binary
