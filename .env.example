# ---------------------------------------------------------------------------
# StudioDesk - copy to `.env` and fill in. Everything has a free tier or is
# open source. The whole app runs with ZERO of these set (in-memory demo mode).
# ---------------------------------------------------------------------------

# --- App -------------------------------------------------------------------
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
PUBLIC_WEB_URL=http://localhost:3000
API_URL=http://localhost:4000

# --- API security ----------------------------------------------------------
# REQUIRED when NODE_ENV=production. The API refuses to boot without it.
# Generate with: openssl rand -hex 32
# Send it as `Authorization: Bearer <key>` or `X-Api-Key: <key>`.
API_KEY=

# Explicit CORS allowlist. Comma-separated for several origins.
# The API refuses to start in production if this is `*`.
CORS_ORIGIN=http://localhost:3000
# Legacy alias for CORS_ORIGIN (checked after CORS_ORIGIN).
ALLOWED_ORIGIN=

# Rate limiting: 300 requests/min/IP by default. Set true only for load tests.
RATE_LIMIT_DISABLED=false
# How long a graceful shutdown may take before the process is forced to exit.
SHUTDOWN_TIMEOUT_MS=10000
# Seed the demo studio on boot when the database is empty. Never enable in prod.
SEED_ON_BOOT=false

# --- Cloudflare ------------------------------------------------------------
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=

# --- Auth.js / NextAuth (free) ---------------------------------------------
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-openssl-rand-base64-32
# Google OAuth (free, optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub OAuth (free, optional)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Credentials provider (always available, no external account needed)
ALLOW_EMAIL_LOGIN=true

# --- Supabase (free tier: 500MB DB, 1GB storage, 5GB egress/mo) -------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Groq (free LLM: churn prediction + member insights) --------------------
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Email: Resend free tier (3000/mo) or useSend (self-hosted) -----------
RESEND_API_KEY=
EMAIL_FROM=StudioDesk <hello@studiodesk.app>
USE_SEND_URL=
USE_SEND_TOKEN=

# --- Payments --------------------------------------------------------------
# Polar (open source, 4% + 40c) - recommended for the $39/$99 subscriptions
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_PRODUCT_STARTER=
POLAR_PRODUCT_BUSINESS=
# Stripe - per-transaction only (2.9% + 30c), used for packs / drop-ins / fees
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Lemon Squeezy - Pakistan friendly alternative to Polar
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
# Which gateway handles recurring memberships
RECURRING_GATEWAY=polar

# --- Check-in signing secret (HMAC for QR tickets) -------------------------
CHECKIN_SIGNING_SECRET=change-me-too

# --- Mobile ----------------------------------------------------------------
# The Expo app talks to the HTTP API, so this is its only required var.
EXPO_PUBLIC_API_URL=http://localhost:4000
# Optional: map tiles in the app.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- UptimeFlare (free uptime monitoring) ----------------------------------
UPTIMEFLARE_API_KEY=

# --- Site metadata ---------------------------------------------------------
# Absolute URLs for Next.js metadata and Open Graph tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Domain (EU.org free) ---------------------------------------------------
EUORG_DOMAIN_API_TOKEN=
