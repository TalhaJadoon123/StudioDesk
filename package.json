{
  "name": "studiodesk",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "StudioDesk - memberships, class booking and billing for small gyms and studios.",
  "license": "MIT",
  "engines": {
    "node": ">=20.11"
  },
  "//": "packages/web and packages/mobile are intentionally NOT root workspaces: Next.js and Expo are large and pull thousands of optional native packages. Install them on demand with `npm run setup:web` / `npm run setup:mobile`.",
  "workspaces": [
    "packages/shared",
    "packages/core",
    "packages/booking",
    "packages/billing",
    "packages/checkin",
    "packages/api",
    "packages/docs"
  ],
  "scripts": {
    "setup": "npm install",
    "setup:web": "npm install --prefix packages/web",
    "setup:mobile": "npm install --prefix packages/mobile",
    "setup:all": "npm install && npm run setup:web && npm run setup:mobile",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:tests": "tsc -p tsconfig.test.json --noEmit",
    "typecheck:all": "npm run typecheck && npm run typecheck:tests",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "npm run typecheck:all && npm test",
    "verify": "node scripts/verify-node-modules.cjs",
    "audit:errors": "node scripts/audit-error-throws.cjs",
    "dev": "npm run dev:api",
    "dev:api": "tsx watch packages/api/src/main.ts",
    "dev:web": "npm --prefix packages/web run dev",
    "dev:mobile": "npm --prefix packages/mobile run start",
    "start:api": "tsx packages/api/src/main.ts",
    "seed": "tsx packages/core/src/scripts/seed.ts",
    "seed:demo": "tsx packages/core/src/scripts/seed.ts --demo",
    "schema:print": "tsx packages/core/src/scripts/db-types.ts",
    "invoice:pdf": "tsx packages/billing/src/scripts/invoice.ts",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f api",
    "docker:seed": "docker compose exec api npm run seed:demo",
    "deploy:worker": "wrangler deploy -f packages/api/wrangler.toml",
    "deploy:pages": "npm --prefix packages/web run deploy:pages"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/qrcode": "^1.5.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.47.9",
    "fastify": "^4.28.1",
    "qrcode": "^1.5.4",
    "zod": "^3.24.1"
  }
}
